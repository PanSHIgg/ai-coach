# ============================================================
# AI 饮食管控教练 · 环境变量模板
# 复制为 .env 后按需填写；真实 .env 不入库（已在 .gitignore）
# ============================================================

# ---------- 应用配置 ----------
APP_NAME=AI 饮食管控教练 API
ENV=dev  # dev/sandbox/prod（生产必须 prod，且 PAY_MOCK_MODE 必须 false）
DEBUG=false
API_PREFIX=/api
CORS_ALLOW_ORIGINS=*  # 逗号分隔；生产环境请指定具体域名

# ---------- PostgreSQL ----------
# 数据库连接（compose 内服务名为 postgres；主机部署时改为主机名/云库地址）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_coach
POSTGRES_USER=postgres
# 生产环境务必改强密码
POSTGRES_PASSWORD=postgres
# 供 SQLAlchemy 使用的完整 DSN（与上面保持一致）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_coach

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
# 供应用使用的完整 DSN
REDIS_URL=redis://redis:6379/0

# ---------- JWT ----------
# JWT 签名密钥，生产环境必须替换为随机长字符串（如 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
# access token 有效期（小时）与 refresh token 有效期（天）
JWT_ACCESS_EXPIRE_HOURS=2
JWT_REFRESH_EXPIRE_DAYS=7

# ---------- 微信小程序 ----------
WECHAT_APPID=
WECHAT_SECRET=
# 微信支付（P0 沙箱/Mock，W11 联调替换正式商户号）
WECHAT_MCH_ID=
WECHAT_PAY_KEY=
# 沙箱支付模式：true 时 pay 即推进支付成功（演示闭环）；生产必须 false
PAY_MOCK_MODE=false

# ---------- 腾讯云 COS（对象存储） ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
# 上传文件的自定义域名（可选，默认走 bucket 域名）
COS_BASE_URL=

# ---------- AI（LLM/VLM：OpenAI 兼容格式，使用时按厂商设置 base_url/api_key/model） ----------
# OpenAI 兼容端点（/v1/chat/completions），DeepSeek/通义/ModelScope/混元等均提供，换厂商只改 env。
# base_url 须含 /v1；未配置时后端明确降级（Mock/模板），不崩。
LLM_BASE_URL=  # 如 https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=  # 如 deepseek-chat / qwen-plus
VLM_BASE_URL=  # 如 https://api-inference.modelscope.cn/v1
VLM_API_KEY=
VLM_MODEL=  # 须为带视觉能力的模型，如 Qwen/Qwen3.8-Flash-Next

# ---------- AI 通用配置 ----------
AI_TIMEOUT=5  # AI 调用超时秒数（P95<3s，超时降级 FAQ 6001）
AI_CONFIDENCE_THRESHOLD=0.7  # 识别置信度阈值（低于此值需用户确认）
AI_DAILY_TIMES=10  # 每日 AI 对话次数配额

# ---------- 限流配置 ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_PER_MIN=100  # 全局 100/min/IP
RATE_LIMIT_AI_PER_MIN=20  # AI 对话 20/min/用户
RATE_LIMIT_AUTH_PER_MIN=10  # C 端登录 10/min/IP
RATE_LIMIT_ADMIN_LOGIN_PER_MIN=5  # admin 登录 5/min/IP（IS-007）

# ---------- 管理后台初始账号 ----------
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=admin123456

# ---------- 日志 ----------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- Nginx / 网络 ----------
# API 服务端口（容器内）
API_PORT=8000
# Nginx 对外端口
NGINX_PORT=80
