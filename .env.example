# ============================================================
# AI 饮食管控教练 · 环境变量模板
# 复制为 .env 后按需填写；真实 .env 不入库（已在 .gitignore）
# ============================================================

# ---------- 应用配置 ----------
APP_NAME=AI 饮食管控教练 API
ENV=dev  # dev/sandbox/prod（生产必须 prod，且 PAY_MOCK_MODE 必须 false）
DEBUG=false
API_PREFIX=/api
CORS_ALLOW_ORIGINS=*  # 逗号分隔；生产环境请指定具体域名

# ---------- PostgreSQL ----------
# 数据库连接（compose 内服务名为 postgres；主机部署时改为主机名/云库地址）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_coach
POSTGRES_USER=postgres
# 生产环境务必改强密码
POSTGRES_PASSWORD=postgres
# 供 SQLAlchemy 使用的完整 DSN（与上面保持一致）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_coach

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
# 供应用使用的完整 DSN
REDIS_URL=redis://redis:6379/0

# ---------- JWT ----------
# JWT 签名密钥，生产环境必须替换为随机长字符串（如 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
# access token 有效期（小时）与 refresh token 有效期（天）
JWT_ACCESS_EXPIRE_HOURS=2
JWT_REFRESH_EXPIRE_DAYS=7

# ---------- 微信小程序 ----------
WECHAT_APPID=
WECHAT_SECRET=
# 微信支付（P0 沙箱/Mock，W11 联调替换正式商户号）
WECHAT_MCH_ID=
WECHAT_PAY_KEY=
# 沙箱支付模式：true 时 pay 即推进支付成功（演示闭环）；生产必须 false
PAY_MOCK_MODE=false

# ---------- 腾讯云 COS（对象存储） ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
# 上传文件的自定义域名（可选，默认走 bucket 域名）
COS_BASE_URL=

# ---------- AI Provider（已废弃，仅保留向后兼容）----------
# LLM 提供方：deepseek / qwen（通义千问）
AI_LLM_PROVIDER=deepseek
# 视觉识别提供方：tencent / aliyun
AI_VISION_PROVIDER=tencent
# 统一 API Key（分属不同云时可分别用 LLM/VISION 前缀覆盖）
AI_API_KEY=
AI_LLM_API_KEY=
AI_VISION_API_KEY=
# 自定义 API 地址（可选，代理/兼容网关时使用）
AI_BASE_URL=
AI_LLM_BASE_URL=
AI_VISION_BASE_URL=
# 对话模型名（如 deepseek-chat / qwen-plus）
AI_LLM_MODEL=deepseek-chat

# ---------- ModelScope / Qwen（ai_api.md：Qwen3.8-Flash-Next，自带视觉）----------
# 对话 + 拍照识别统一走这一个模型（VLM），无需另接视觉 API
MS_API_KEY=
MS_BASE_URL=https://api-inference.modelscope.cn/v1
MS_MODEL=Qwen/Qwen3.8-Flash-Next
MS_ENABLE_THINKING=false
MS_MAX_TOKENS=1024
MS_TIMEOUT=5  # AI P95<3s，超时上限 5s 留余量

# ---------- AI 通用配置 ----------
AI_CONFIDENCE_THRESHOLD=0.7  # 识别置信度阈值（低于此值需用户确认）
AI_DAILY_TIMES=10  # 每日 AI 对话次数配额

# ---------- 限流配置 ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_PER_MIN=100  # 全局 100/min/IP
RATE_LIMIT_AI_PER_MIN=20  # AI 对话 20/min/用户
RATE_LIMIT_AUTH_PER_MIN=10  # C 端登录 10/min/IP
RATE_LIMIT_ADMIN_LOGIN_PER_MIN=5  # admin 登录 5/min/IP（IS-007）

# ---------- 管理后台初始账号 ----------
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=admin123456

# ---------- 日志 ----------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- Nginx / 网络 ----------
# API 服务端口（容器内）
API_PORT=8000
# Nginx 对外端口
NGINX_PORT=80
