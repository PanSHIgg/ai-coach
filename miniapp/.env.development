# ============================================================
# miniapp 开发环境变量（P0-f）
# 说明：VITE_ 前缀变量会暴露给前端代码（import.meta.env）。
# Mock Server：node ../contracts/mock/server.mjs（默认端口 9000）
# ============================================================

# 后端 API 基地址（Mock Server 地址）
VITE_API_BASE=http://localhost:9000

# 是否走 Mock 态（true：登录页直接 mock 登录，不调 wx.login）
VITE_USE_MOCK=true
