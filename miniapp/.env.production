# ============================================================
# miniapp 生产环境变量（Phase 5 F9）
# 说明：VITE_ 前缀变量会暴露给前端代码（import.meta.env）。
# ============================================================

# 后端 API 基址（**发布前必须按真实部署填写**）：
#   - H5 部署：留空 = 同源，由 nginx 反代 /api（见 deploy/nginx.conf）
#   - 小程序打包：必须填绝对域名（如 https://api.your-domain.com），
#     并在微信公众平台「开发设置 → 服务器域名」配置 request 合法域名
VITE_API_BASE=

# 生产禁用 Mock 态（登录必须走真实 wx.login / code2session）
VITE_USE_MOCK=false
