# AI 饮食管控教练 · 后端镜像（§10.3 / 主文档 :1637：python:3.12-slim、多阶段构建、非 root、暴露 8000）
# 构建上下文为 monorepo 根目录（compose 中 context: ..，dockerfile: deploy/Dockerfile.backend）
#
# 多阶段：builder 负责安装依赖产出 site-packages/bin → runtime 仅拷产物与源码，
# 不含构建缓存/编译工具，镜像更小；runtime 以非 root 用户运行。

# ---------- 阶段 1：builder（安装依赖）----------
FROM python:3.12-slim AS builder

# PyPI 镜像源（默认腾讯 mirrors.tencent.com，与国内网络环境一致；可用 --build-arg 覆盖）
ARG PIP_INDEX_URL=https://mirrors.tencent.com/pypi/simple/
ENV PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# 先拷依赖清单单独安装，充分利用层缓存
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# ---------- 阶段 2：runtime（仅拷贝产物，非 root 运行）----------
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Asia/Shanghai

WORKDIR /app

# 仅从 builder 拷贝已安装的依赖与可执行入口，不带入构建工具/缓存
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 拷贝后端源码（app/ 由 P0-e 脚手架交付）
COPY backend/ /app/

# 非 root 运行
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# 服务健康检查（GET /healthz 由 P0-e 脚手架提供）
HEALTHCHECK --interval=30s --timeout=5s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)" || exit 1

# 多 worker 启动（§6.4：uvicorn 多 worker）
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]