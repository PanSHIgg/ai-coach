# AI 饮食管控教练 · 后端镜像（§10.3：python:3.12-slim、非 root、暴露 8000）
# 构建上下文为 monorepo 根目录（compose 中 context: ..，dockerfile: deploy/Dockerfile.backend）

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai

WORKDIR /app

# 先拷依赖清单单独安装，充分利用层缓存
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 拷贝后端源码（app/ 由 P0-e 脚手架交付；尚未就绪前镜像可构建但不提供服务）
COPY backend/ /app/

# 非 root 运行
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# 服务健康检查（/healthz 由 P0-e 脚手架提供后取消注释）
# HEALTHCHECK --interval=30s --timeout=5s --retries=5 \
#   CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)" || exit 1

# 多 worker 启动（§6.4：uvicorn 多 worker）
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
