  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "接口 QPS：rate(http_requests_total)，按状态码分组。",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "接口 QPS（按状态码）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "接口延迟 P95 / P99：histogram_quantile over http_request_duration_seconds_bucket。",
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P95",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P99",
          "refId": "B"
        }
      ],
      "title": "接口延迟 P95 / P99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "5xx 错误率 = 5xx 请求数 / 全部请求数；阈值 5%（告警线）。两侧都做了空序列兜底：无 5xx 时分子 `or vector(0)`，无流量时分母 `or vector(1)`（此时显示 0%）——否则 0/0 出 NaN，Y 轴会被顶到 10000% 且面板 No data。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(http_requests_total{status=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_requests_total[$__rate_interval])) or vector(1))",
          "legendFormat": "错误率",
          "refId": "A"
        }
      ],
      "title": "错误率（5xx）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "热量账户计算耗时 P50 / P95（calorie_calc_seconds）。埋点在 account.compute_result，只圈纯计算，不含取数的 DB 等待。",
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(calorie_calc_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P95",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(calorie_calc_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P50",
          "refId": "B"
        }
      ],
      "title": "热量计算耗时 P50 / P95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "窗口增量口径：calls 按 task、tokens 按 type=input|output|cached（cached 是命中前缀缓存的输入部分）。为什么不用 rate()：本项目是低频突发——一次提问的工具循环会在同一个 15s 抓取间隙里连调数次，`rate()` 摊到每秒就是 0（实测 3 次调用显示 0.000），`increase()` 才看得见。只含真实厂商调用，Mock 降级不发 HTTP。",
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (task) (increase(ai_calls_total[$__rate_interval]))",
          "legendFormat": "calls {{task}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (type) (increase(ai_tokens_total[$__rate_interval]))",
          "legendFormat": "tok {{type}}",
          "refId": "B"
        }
      ],
      "title": "AI 调用与 token 用量",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "AI 成本估算（ai_cost_usd_total = [(input−cached)×输入价 + cached×缓存价 + output×输出价]/1e6，牌价见根 .env 的 AI_PRICE_*）。牌价未填时恒为 $0——这条线是 0 不代表没调用，看左边那个面板。",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "min": 0,
          "decimals": 4
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "id": 14,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (task) (increase(ai_cost_usd_total[1h]))",
          "legendFormat": "$/h {{task}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(ai_cost_usd_total[24h]))",
          "legendFormat": "近 24h 合计($)",
          "refId": "B"
        }
      ],
      "title": "AI 成本估算",
      "type": "timeseries"
    },
    {
      "collapsed": false,
