    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Redis 内存（redis_exporter）：used / peak / maxmemory。maxmemory 为 0 表示未设上限（此时驱逐只受系统内存约束）。",
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 17 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "redis_memory_used_peak_bytes",
          "legendFormat": "peak",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "redis_memory_max_bytes",
          "legendFormat": "maxmemory",
          "refId": "C"
        }
      ],
      "title": "Redis 内存",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Redis 连接与吞吐：clients/blocked、命令速率、驱逐与过期速率。evicted>0 通常意味着内存到顶。",
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 17 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "redis_connected_clients",
          "legendFormat": "clients",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "redis_blocked_clients",
          "legendFormat": "blocked",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(redis_commands_processed_total[$__rate_interval])",
          "legendFormat": "commands/s",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(redis_evicted_keys_total[$__rate_interval])",
          "legendFormat": "evicted/s",
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(redis_expired_keys_total[$__rate_interval])",
          "legendFormat": "expired/s",
          "refId": "E"
        }
      ],
      "title": "Redis 连接与吞吐",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Redis 键空间命中率 = hits/(hits+misses)。分母 clamp 到 ≥1：空闲窗口按 100% 画，避免「No data」被当成故障。阈值 95%。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 17 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - (sum(rate(redis_keyspace_misses_total[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(redis_keyspace_hits_total[$__rate_interval])) + sum(rate(redis_keyspace_misses_total[$__rate_interval])), 1)",
          "legendFormat": "命中率",
          "refId": "A"
        }
      ],
      "title": "Redis 命中率",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "PG 连接数（postgres_exporter pg_stat_activity，按状态）与服务器 max_connections。datname 固定 ai_coach=部署库（本机另有并行 slot 库，不计入）。idle in transaction 长期占用会耗尽连接池。",
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 17 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (state) (pg_stat_activity_count{datname=\"ai_coach\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_settings_max_connections",
          "legendFormat": "max_connections",
          "refId": "B"
        }
      ],
      "title": "PG 连接数（按状态）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "PG 事务与行吞吐：commit/s、rollback/s、返回行/s（pg_stat_database）。rollback 持续占比高说明有约束/死锁冲突。",
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 25 },
      "id": 11,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"ai_coach\"}[$__rate_interval]))",
          "legendFormat": "commit/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"ai_coach\"}[$__rate_interval]))",
          "legendFormat": "rollback/s",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_tup_returned{datname=\"ai_coach\"}[$__rate_interval]))",
          "legendFormat": "rows/s",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_deadlocks{datname=\"ai_coach\"}[$__rate_interval]))",
          "legendFormat": "deadlocks/s",
          "refId": "D"
        }
      ],
      "title": "PG 事务与吞吐",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "PG 缓存命中率 = blks_hit/(blks_hit+blks_read)。分母 clamp 到 ≥1，空闲窗口按 100% 画。低于 95% 说明读盘多（工作集超出 shared_buffers）。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 25 },
      "id": 12,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"ai_coach\"}[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"ai_coach\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=\"ai_coach\"}[$__rate_interval])), 1)",
          "legendFormat": "缓存命中率",
          "refId": "A"
        }
      ],
      "title": "PG 缓存命中率",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "PG 体积与锁：部署库占用磁盘（pg_database_size_bytes）与持锁总数（pg_locks_count 求和）。库大小增长是磁盘告警的前置信号。",
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "持锁总数" },
            "properties": [{ "id": "unit", "value": "short" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 25 },
      "id": 13,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_database_size_bytes{datname=\"ai_coach\"}",
          "legendFormat": "库大小",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(pg_locks_count{datname=\"ai_coach\"})",
          "legendFormat": "持锁总数",
          "refId": "B"
        }
      ],
      "title": "PG 体积与锁",
      "type": "timeseries"
    }
