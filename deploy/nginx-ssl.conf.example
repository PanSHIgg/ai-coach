
# ============================================================
# 443：生产入口（Let's Encrypt + Certbot）
# 证书路径为占位；首次部署先用 Certbot 生成：
#   certbot certonly --webroot -w /var/www/certbot -d your.domain.com
# ⚠️ 证书文件不存在时 nginx 启动会失败：dev 环境请先注释本 server 块。
# ============================================================
server {
    listen 443 ssl;
    http2 on;
    server_name your.domain.com;

    ssl_certificate     /etc/letsencrypt/live/your.domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your.domain.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # ACME HTTP-01 校验目录（Certbot webroot；配合 80 块的 /.well-known 放行）
    # location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }

    client_max_body_size 20m;

    # ---- gzip ----
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1k;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    # 安全响应头（HTTPS 专属）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # ---- API 反代 ----
    location ^~ /api/ {
        limit_req zone=perip burst=200 nodelay;
        proxy_pass http://api_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }

    # ---- 管理后台静态 ----
    location ^~ /admin/ {
        alias /usr/share/nginx/html/admin/;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }

    # ---- 媒体/上传文件 ----
    location ^~ /uploads/ {
        alias /uploads/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # ---- 探活 ----
    location = /healthz {
        return 200 "ok";
    }

    # ---- 静态资源缓存 7 天 ----
    location ~* \.(?:js|css|png|jpg|jpeg|gif|webp|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # ---- 站点根（HTML 不缓存）----
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
